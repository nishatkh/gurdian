# Guardian AI Backend & Infrastructure Environment Configuration
# Copy to backend/.env and fill in real secrets before launching.
# NEVER commit backend/.env or real API keys to version control.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://guardian:guardian@postgres:5432/guardian_ai
REDIS_URL=redis://redis:6379/0

# Security & Field Encryption (generate 32+ char secret and Fernet key for production)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_JWT_SECRET_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FIELD_ENCRYPTION_KEY=

# LLM Provider Configuration (Groq primary, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_ALLOW_SENSITIVE_FALLBACK=false
LLM_TIMEOUT_SECONDS=20

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
