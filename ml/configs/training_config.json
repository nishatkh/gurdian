{
  "random_seed": 42,
  "dataset_name": "UCI Human Activity Recognition Using Smartphones",
  "dataset_url": "https://archive.ics.uci.edu/static/public/240/human+activity+recognition+using+smartphones.zip",
  "raw_dir": "ml/raw/uci_har",
  "processed_dir": "ml/processed",
  "models_dir": "ml/models",
  "reports_dir": "ml/reports",
  "model_version": "guardian-har-v1.0.0",
  "task_a_models": [
    "logistic_regression",
    "decision_tree",
    "random_forest",
    "linear_svc",
